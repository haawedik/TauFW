# Full-PNet 2526 corrTES fit (WITH Zmm CR): one job per VSjet WP (runs the per-WP chain only).
# Submit AFTER inputs.sub + mumu.sub finish and merge_inputs.sh has run.
# Submit from Fitter/condor/ (after make_proxy.sh + RELEASE_SRC/FITTER_DIR exports): condor_submit fit.sub
universe       = vanilla
executable     = run_fit.sh
arguments      = $(WP)
environment    = RELEASE_SRC=$ENV(RELEASE_SRC);FITTER_DIR=$ENV(FITTER_DIR)
request_cpus   = 1
request_memory = 4 GB
+JobFlavour    = "longlunch"
x509userproxy  = $ENV(X509_USER_PROXY)
should_transfer_files = NO
output         = logs/fit_$(WP).$(ClusterId).out
error          = logs/fit_$(WP).$(ClusterId).err
log            = logs/fit.$(ClusterId).log
queue WP from (
Loose
Medium
Tight
VTight
VVTight
)
