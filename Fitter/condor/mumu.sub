# Full-PNet 2526 Z->mumu CR inputs: ONE job (single baseline region; content is VSjet/VSe-independent).
# Builds the CR once and symlinks it into every VSjet x VSe dir. Submit from Fitter/condor/
# (after make_proxy.sh + RELEASE_SRC/FITTER_DIR exports): condor_submit mumu.sub
universe       = vanilla
executable     = run_mumu.sh
environment    = RELEASE_SRC=$ENV(RELEASE_SRC);FITTER_DIR=$ENV(FITTER_DIR)
request_cpus   = 4
request_memory = 4 GB
+JobFlavour    = "longlunch"
x509userproxy  = $ENV(X509_USER_PROXY)
should_transfer_files = NO
output         = logs/mumu.$(ClusterId).out
error          = logs/mumu.$(ClusterId).err
log            = logs/mumu.$(ClusterId).log
queue 1
